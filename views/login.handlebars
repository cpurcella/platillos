<!DOCTYPE html>
<html lang="en">
<head>
    <title>Platillos - Login</title>
    {{> head}}
</head>
<body>
    <div class="login-container">
        <h1 class="platillos-title">Platillos</h1>
        <form id="loginForm">
            <div class="form-group">
                <label class="form-label" for="email">Email</label>
                <input class="form-input" type="email" id="email" name="email" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                <input class="form-input" type="password" id="password" name="password" required>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-turquoise">Login</button>
                <a href="/register" class="btn text-turquoise" id="showRegister">Register</a>
            </div>
        </form>
        <div id="login-error-message" style="display:none;"></div>
    </div>
    <script src="/js/login.js"></script>
</body>
</html>
