<header class="header-bar">
    <link rel="stylesheet" href="/styles/header.css">
    <div class="header-content">
        <a href="/" class="header-logo">Platillos</a>
        <nav class="header-nav">
            <span class="header-auth-group auth-only" {{#unless user}}hidden{{/unless}}>
                <a href="/admin" class="btn btn-turquoise js-admin-link" {{#unless user.isAdmin}}hidden{{/unless}}>Admin</a>
                <a href="{{#if user.username}}/users/{{user.username}}{{else}}#{{/if}}" class="header-profile-link js-user-profile-link" title="Profile">
                    <img class="header-avatar js-user-avatar-image" {{#if user.avatarUrl}}src="{{user.avatarUrl}}"{{else}}hidden{{/if}} alt="Profile">
                    <span class="header-avatar header-avatar-initial js-user-avatar-initial js-user-initial" {{#if user.avatarUrl}}hidden{{/if}}>{{initial user.firstName}}</span>
                    <span class="header-profile-text">Profile</span>
                </a>
            </span>
            <span class="header-auth-group guest-only" {{#if user}}hidden{{/if}}>
                <a href="/login" class="btn btn-turquoise">Login</a>
                <a href="/register" class="btn btn-turquoise">Register</a>
            </span>
        </nav>
    </div>
</header>
