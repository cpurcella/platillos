<header class="header-bar">
    <link rel="stylesheet" href="/styles/header.css">
    <div class="header-content">
        <a href="/" class="header-logo">Platillos</a>
        <nav class="header-nav">
            {{#if user}}
                {{#if user.isAdmin}}
                    <a href="/admin/approvals" class="btn btn-turquoise">Approvals</a>
                {{/if}}
                <span style="display:none" class="header-welcome">Welcome, {{user.firstName}}!</span>
                <a href="/logout" class="btn btn-turquoise">Logout</a>
            {{else}}
                <a href="/login" class="btn btn-turquoise">Login</a>
                <a href="/register" class="btn text-turquoise">Register</a>
            {{/if}}
        </nav>
    </div>
</header>
