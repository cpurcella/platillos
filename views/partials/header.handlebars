<header class="header-bar">
    <link rel="stylesheet" href="/styles/header.css">
    <div class="header-content">
        <a href="/" class="header-logo">Platillos</a>
        <nav class="header-nav">
            {{#if user}}
                {{#if user.isAdmin}}
                    <a href="/admin/approvals" class="btn btn-turquoise">Approvals</a>
                {{/if}}
                {{#if user.username}}
                    <a href="/users/{{user.username}}" class="btn btn-turquoise">Profile</a>
                {{/if}}
                <a href="/logout" class="btn btn-turquoise">Logout</a>
            {{else}}
                <a href="/login" class="btn btn-turquoise">Login</a>
                <a href="/register" class="btn btn-turquoise">Register</a>
            {{/if}}
        </nav>
    </div>
</header>
