<header class="header-bar">
    <link rel="stylesheet" href="/styles/header.css">
    <div class="header-content">
        <a href="/" class="header-logo">Platillos</a>
        <nav class="header-nav">
            {{#if user}}
                {{#if user.isAdmin}}
                    <a href="/admin" class="btn btn-turquoise">Admin</a>
                {{/if}}
                {{#if user.username}}
                    <a href="/users/{{user.username}}" class="header-profile-link" title="Profile">
                        {{#if user.avatarUrl}}
                            <img src="{{user.avatarUrl}}" alt="Profile" class="header-avatar">
                        {{else}}
                            <span class="header-avatar header-avatar-initial">{{initial user.firstName}}</span>
                        {{/if}}
                        <span class="header-profile-text">Profile</span>
                    </a>
                {{/if}}
            {{else}}
                <a href="/login" class="btn btn-turquoise">Login</a>
                <a href="/register" class="btn btn-turquoise">Register</a>
            {{/if}}
        </nav>
    </div>
</header>
