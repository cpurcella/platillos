<link rel="stylesheet" href="/styles/login-popup.css">
<div id="login-overlay"></div>
<div id="login-popup" class="popup hidden" role="dialog" aria-modal="true" aria-labelledby="login-popup-title">
    <div class="popup-content">
        <h2 id="login-popup-title">Login Required</h2>
        <p>You must be logged in to access this feature.</p>
        <a href="/login" class="btn btn-turquoise">Login</a>
        <button class="btn btn-gray" id="close-popup" type="button">Close</button>
    </div>
</div>
<script src="/js/login-popup.js"></script>
