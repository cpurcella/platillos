<!DOCTYPE html>
<html lang="en">
<head>
    <title>Platillos - Admin</title>
    {{> head}}
    <link rel="stylesheet" href="/styles/index.css">
    <link rel="stylesheet" href="/styles/approvals.css">
    <link rel="stylesheet" href="https://unpkg.com/gridjs/dist/theme/mermaid.min.css">
    <script src="https://unpkg.com/gridjs/dist/gridjs.umd.js"></script>
</head>
<body class="bg-mint">
    {{> header}}
    <div id="approvals-container" class="approvals-page">

        <div class="tabs admin-tabs">
            <a href="javascript:void(0)">Reviews <span id="badge-reviews" class="tab-badge" style="display:none;"></span></a>
            <a href="javascript:void(0)">Dishes <span id="badge-dishes" class="tab-badge" style="display:none;"></span></a>
            <a href="javascript:void(0)">Restaurants <span id="badge-restaurants" class="tab-badge" style="display:none;"></span></a>
            <a href="javascript:void(0)">Photos <span id="badge-photos" class="tab-badge" style="display:none;"></span></a>
            <a href="javascript:void(0)">Users</a>
        </div>

        <div class="tab-panels">
            <div class="tab-content" id="tab-reviews">
                <div class="grid-filter">
                    <label for="reviews-status-filter">Show</label>
                    <select id="reviews-status-filter">
                        <option value="pending" selected>Pending</option>
                        <option value="needs_review">Needs Review</option>
                        <option value="out_of_area">Out of Area</option>
                        <option value="approved">Approved</option>
                        <option value="rejected">Rejected</option>
                        <option value="all">All</option>
                    </select>
                </div>
                <div id="reviews-grid"></div>
            </div>
            <div class="tab-content" id="tab-dishes">
                <div class="grid-filter">
                    <label for="dishes-status-filter">Show</label>
                    <select id="dishes-status-filter">
                        <option value="pending" selected>Pending</option>
                        <option value="needs_review">Needs Review</option>
                        <option value="out_of_area">Out of Area</option>
                        <option value="approved">Approved</option>
                        <option value="rejected">Rejected</option>
                        <option value="all">All</option>
                    </select>
                </div>
                <div id="dishes-grid"></div>
            </div>
            <div class="tab-content" id="tab-restaurants">
                <div class="grid-filter">
                    <label for="restaurants-status-filter">Show</label>
                    <select id="restaurants-status-filter">
                        <option value="pending" selected>Pending</option>
                        <option value="needs_review">Needs Review</option>
                        <option value="out_of_area">Out of Area</option>
                        <option value="approved">Approved</option>
                        <option value="rejected">Rejected</option>
                        <option value="all">All</option>
                    </select>
                </div>
                <div id="restaurants-grid"></div>
            </div>
            <div class="tab-content" id="tab-images">
                <div class="grid-filter">
                    <label for="photos-status-filter">Show</label>
                    <select id="photos-status-filter">
                        <option value="pending" selected>Pending</option>
                        <option value="needs_review">Needs Review</option>
                        <option value="out_of_area">Out of Area</option>
                        <option value="approved">Approved</option>
                        <option value="rejected">Rejected</option>
                        <option value="all">All</option>
                    </select>
                </div>
                <div id="photos-grid"></div>
            </div>
            <div class="tab-content" id="tab-users">
                <div class="grid-filter">
                    <label for="users-search-filter">Search</label>
                    <input id="users-search-filter" type="search" placeholder="Name, username, or email">
                </div>
                <div id="users-grid"></div>
            </div>
        </div>
    </div>
    {{> footer}}
    <script src="/js/approvals.js"></script>
</body>
</html>
