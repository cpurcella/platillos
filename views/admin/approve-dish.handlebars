<div id="approve-dish-modal" class="modal">
    <div class="modal-content">
        <button class="close-modal" aria-label="Close">&times;</button>
        <h2>Review Dish</h2>
        <div id="approve-dish-content">
            <div class="dish-summary">
                <div>
                    <div class="dish-summary-label">Dish</div>
                    <input type="text" id="approve-dish-name" class="approve-dish-name-input" />
                </div>
                <div>
                    <div class="dish-summary-label">Restaurant</div>
                    <div id="approve-dish-restaurant"></div>
                </div>
                <div>
                    <div class="dish-summary-label">Submitted</div>
                    <div id="approve-dish-submitted"></div>
                </div>
            </div>
            <div class="metadata-section">
                <div class="metadata-section-title">Metadata</div>
                <div id="metadata-error" class="metadata-error"></div>
                <div class="metadata-groups">
                    <div class="metadata-group" data-field="categories">
                        <label class="metadata-group-label">Categories</label>
                        <input type="text" class="metadata-filter-input" data-target="dish-categories-chips" placeholder="Filter categories">
                        <div id="dish-categories-chips" class="metadata-chip-list" role="listbox" aria-multiselectable="true"></div>
                    </div>
                    <div class="metadata-group" data-field="dishTypes">
                        <label class="metadata-group-label">Dish Types</label>
                        <input type="text" class="metadata-filter-input" data-target="dish-types-chips" placeholder="Filter dish types">
                        <div id="dish-types-chips" class="metadata-chip-list" role="listbox" aria-multiselectable="true"></div>
                    </div>
                    <div class="metadata-group" data-field="tags">
                        <label class="metadata-group-label">Tags</label>
                        <input type="text" class="metadata-filter-input" data-target="dish-tags-chips" placeholder="Filter tags">
                        <div id="dish-tags-chips" class="metadata-chip-list" role="listbox" aria-multiselectable="true"></div>
                    </div>
                </div>
            </div>
        </div>
        <div id="ai-dish-stored-reasoning" class="ai-reasoning-stored" style="display:none;">
            <div class="ai-reasoning-stored-title">AI Reasoning</div>
            <div id="ai-dish-stored-reasoning-text" class="ai-reasoning-stored-text"></div>
        </div>
        <div class="form-row approve-dish-status-row">
            <label for="dish-status-select" class="approve-dish-status-label">Status</label>
            <select id="dish-status-select" class="approve-dish-status-select">
                <option value="pending">Pending</option>
                <option value="needs_review">Needs Review</option>
                <option value="out_of_area">Out of Area</option>
                <option value="approved">Approved</option>
                <option value="rejected">Rejected</option>
            </select>
        </div>
        <div class="form-actions approve-dish-actions">
            <button type="button" class="btn btn-turquoise" id="save-dish-status-btn">Submit</button>
            <button type="button" class="btn btn-outline" id="ai-evaluate-dish-btn">AI Evaluate</button>
        </div>
        <div id="ai-dish-result" class="ai-result-box">
            <div class="ai-result-title">AI Recommendation</div>
            <div id="ai-dish-verdict"></div>
            <div id="ai-dish-reasoning" class="ai-result-reasoning"></div>
            <div id="ai-dish-metadata-suggestions" class="ai-metadata-suggestions"></div>
        </div>
    </div>
    <script src="/js/approve-dish.js"></script>
</div>
<div class="overlay"></div>
