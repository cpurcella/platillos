<div id="approve-review-modal" class="modal">
    <div class="modal-content">
        <button class="close-modal" aria-label="Close">&times;</button>
        <h2>Approve Review</h2>
        <div id="approve-review-content">Loading...</div>
        <div class="form-row" style="margin-top:16px;">
            <label for="review-status-select" style="display:block;margin-bottom:4px;font-weight:600;">Status</label>
            <select id="review-status-select" style="width:100%;padding:6px 8px;">
                <option value="pending">Pending</option>
                <option value="approved">Approved</option>
                <option value="rejected">Rejected</option>
            </select>
        </div>
        <div class="form-actions" style="margin-top:16px;gap:8px;display:flex;">
            <a href="javascript:void(0)" class="btn btn-turquoise" id="save-review-status-btn">Submit</a>
        </div>
    </div>
    <script src="/js/approve-review.js"></script>
</div>
<div class="overlay"></div>
