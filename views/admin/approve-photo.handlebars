<div id="approve-photo-modal" class="modal">
    <div class="modal-content">
        <button class="close-modal" aria-label="Close">&times;</button>
        <h2>Review Photo</h2>
        <form id="approve-photo-form">
            <div id="approve-photo-content">Loading...</div>
            <div class="form-row" style="margin-top:16px;">
                <label for="photo-status-select" style="display:block;margin-bottom:4px;font-weight:600;">Status</label>
                <select id="photo-status-select" style="width:100%;padding:6px 8px;">
                    <option value="pending">Pending</option>
                    <option value="approved">Approved</option>
                    <option value="rejected">Rejected</option>
                </select>
            </div>
            <div class="form-actions" style="margin-top:16px;gap:8px;display:flex;justify-content:flex-end;">
                <button type="submit" class="btn btn-turquoise" id="save-photo-status-btn">Save</button>
            </div>
        </form>
    </div>
    <script src="/js/approve-photo.js"></script>
</div>
<div class="overlay"></div>
