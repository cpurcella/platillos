<div id="approve-photo-modal" class="modal">
    <div class="modal-content">
        <button class="close-modal" aria-label="Close">&times;</button>
        <h2>Review Photo</h2>
        <form id="approve-photo-form">
            <div id="approve-photo-content">Loading...</div>
            <div class="approval-status-row">
                <label for="photo-status-select">Status</label>
                <select id="photo-status-select">
                    <option value="pending">Pending</option>
                    <option value="approved">Approved</option>
                    <option value="rejected">Rejected</option>
                </select>
            </div>
            <div class="approval-actions">
                <button type="submit" class="btn btn-turquoise" id="save-photo-status-btn">Save</button>
                <button type="button" class="btn btn-outline" id="ai-evaluate-photo-btn">AI Evaluate</button>
            </div>
            <div id="ai-photo-result" class="ai-result-box">
                <div class="ai-result-title">AI Recommendation</div>
                <div id="ai-photo-verdict"></div>
                <div id="ai-photo-reasoning" class="ai-result-reasoning"></div>
            </div>
        </form>
    </div>
    <script src="/js/approve-photo.js"></script>
</div>
<div class="overlay"></div>
