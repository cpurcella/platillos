<div id="approve-restaurant-modal" class="modal">
    <div class="modal-content">
        <button class="close-modal" aria-label="Close">&times;</button>
        <h2>Review Restaurant</h2>
        <div id="approve-restaurant-content">
            <form id="approve-restaurant-form" class="approve-restaurant-form">
                <div class="form-grid">
                    <div class="form-field">
                        <label for="restaurant-name-input">Name</label>
                        <input type="text" id="restaurant-name-input" name="name" maxlength="128" required>
                    </div>
                    <div class="form-field">
                        <label for="restaurant-address-input">Address</label>
                        <input type="text" id="restaurant-address-input" name="address" maxlength="128">
                    </div>
                    <div class="form-field">
                        <label for="restaurant-city-input">City</label>
                        <input type="text" id="restaurant-city-input" name="city" maxlength="64" required>
                    </div>
                    <div class="form-field">
                        <label for="restaurant-zip-input">ZIP / Postal Code</label>
                        <input type="text" id="restaurant-zip-input" name="zip" maxlength="16">
                    </div>
                    <div class="form-field">
                        <label for="restaurant-lat-input">Latitude</label>
                        <input type="text" id="restaurant-lat-input" name="lat">
                    </div>
                    <div class="form-field">
                        <label for="restaurant-lng-input">Longitude</label>
                        <input type="text" id="restaurant-lng-input" name="lng">
                    </div>
                </div>
                <div class="approval-status-row">
                    <label for="restaurant-status-select">Status</label>
                    <select id="restaurant-status-select" name="status">
                        <option value="pending">Pending</option>
                        <option value="needs_review">Needs Review</option>
                        <option value="approved">Approved</option>
                        <option value="rejected">Rejected</option>
                    </select>
                </div>
                <div class="approval-info-row">
                    <label>Submitted</label>
                    <div id="restaurant-submitted" class="form-static"></div>
                </div>
                <div class="approval-info-row">
                    <label>Submitted By</label>
                    <div id="restaurant-submitter" class="form-static"></div>
                </div>
                <div class="approval-actions">
                    <button type="submit" class="btn btn-turquoise" id="save-restaurant-status-btn">Save Changes</button>
                    <button type="button" class="btn btn-outline" id="ai-evaluate-restaurant-btn">AI Evaluate</button>
                </div>
                <div id="ai-restaurant-result" class="ai-result-box">
                    <div class="ai-result-title">AI Recommendation</div>
                    <div id="ai-restaurant-verdict"></div>
                    <div id="ai-restaurant-reasoning" class="ai-result-reasoning"></div>
                </div>
            </form>
        </div>
    </div>
    <script src="/js/approve-restaurant.js"></script>
</div>
<div class="overlay"></div>
