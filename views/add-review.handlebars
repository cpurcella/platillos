<div id="add-review-modal" class="modal">
    <link rel="stylesheet" href="/styles/add-review.css">
    <div class="modal-content">
        <button class="close-modal" aria-label="Close">&times;</button>
        <h2>Add a Review</h2>
        <div id="selected-restaurant-container"></div>
        <div id="review-type-section" class="hidden section-block">
            <div class="review-type-options" role="group" aria-label="Review type">
                <button type="button" class="review-type-option" data-item-type="food">Food</button>
                <button type="button" class="review-type-option" data-item-type="drink">Drink</button>
            </div>
        </div>
        <div id="selected-dish-container"></div>
        <div id="restaurant-search-section">
            <form id="add-review-form">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="restaurant-search" id="restaurant-search-label">Where was it?</label>
                        <input type="text" id="restaurant-search" class="form-input" placeholder="Type to search...">
                        <div id="restaurant-list"></div>
                    </div>
                </div>
            </form>
        </div>
        <div id="add-restaurant-section" class="hidden section-block">
            <h3>Add a Restaurant</h3>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="new-restaurant-name">Name</label>
                    <input type="text" id="new-restaurant-name" class="form-input" placeholder="Restaurant name">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="new-restaurant-address">Address (If known)</label>
                    <input type="text" id="new-restaurant-address" class="form-input" placeholder="Street address">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="new-restaurant-city">City</label>
                    <input type="text" id="new-restaurant-city" class="form-input" placeholder="City name">
                </div>
                <div class="form-group">
                    <label class="form-label" for="new-restaurant-state">State</label>
                    <input type="text" id="new-restaurant-state" class="form-input" placeholder="State">
                </div>
                <div class="form-group">
                    <label class="form-label" for="new-restaurant-zip">Zip</label>
                    <input type="text" id="new-restaurant-zip" class="form-input" placeholder="Zip code">
                </div>
            </div>
            <div class="button-row">
                <a href="javascript:void(0)" class="btn btn-turquoise" id="save-restaurant-btn">Add Restaurant</a>
                <a href="javascript:void(0)" class="btn" id="cancel-add-restaurant-btn">Cancel</a>
            </div>
        </div>
        <div id="dish-search-section" class="hidden section-block">
            <label class="form-label" for="dish-list" id="dish-search-label">What did you have?</label>
            <input type="text" id="dish-search" class="form-input" placeholder="Type to search...">
            <div id="dish-list"></div>
        </div>
        <div id="add-dish-section" class="hidden section-block">
            <h3 id="add-dish-title">Add an Item</h3>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="new-dish-name" id="new-dish-name-label">Name</label>
                    <input type="text" id="new-dish-name" class="form-input" placeholder="Name">
                </div>
            </div>
            <div id="drink-style-section" class="hidden">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Drink category</label>
                        <div id="drink-category-options" class="metadata-chip-list"></div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Drink style</label>
                        <div id="drink-type-options" class="metadata-chip-list"></div>
                    </div>
                </div>
            </div>
            <div class="button-row">
                <a href="javascript:void(0)" class="btn btn-turquoise" id="save-dish-btn">Save</a>
                <a href="javascript:void(0)" class="btn" id="cancel-add-dish-btn">Cancel</a>
            </div>
        </div>
        <div id="review-section" class="hidden section-block">
            <div class="rating-favorite-row">
                <div class="rating-group">
                    <label class="form-label" for="rating">Rating (1-10)</label>
                    <select id="rating" class="form-input" required>
                        <option value="" disabled selected>Select a rating</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="7">7</option>
                        <option value="8">8</option>
                        <option value="9">9</option>
                        <option value="10">10</option>
                    </select>
                </div>
                <div class="favorite-group">
                    <label class="form-label">Favorite</label>
                    <label class="favorite-checkbox-row" title="Add to Favorites">
                        <input type="checkbox" id="add-to-favorites" class="hidden">
                        <span class="favorite-checkbox-icon">♡</span>
                    </label>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="review">What did you think?</label>
                    <textarea id="review" class="form-input" rows="4" required></textarea>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="modifications" id="modifications-label">Any modifications?</label>
                    <input type="text" id="modifications" class="form-input" placeholder="Optional notes">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Upload Photos</label>
                    <button type="button" class="btn btn-turquoise" id="photo-upload-btn">Choose Photos</button>
                    <input type="file" id="photo-upload" class="hidden" accept="image/jpeg,image/png,image/webp" multiple>
                    <div id="photo-upload-preview"></div>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-turquoise btn-block" id="submit-review">Submit Review</button>
            </div>
        </div>
    </div>
    <script src="/js/add-review.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/browser-image-compression@latest/dist/browser-image-compression.js"></script>
</div>
<div class="overlay"></div>
