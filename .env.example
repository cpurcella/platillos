# Runtime
env=dev
local=true
PORT=3000
websiteUrl=http://localhost:3000
cookieSecret=replace-with-a-long-random-string

# Database. Use the platillos_qa schema for normal development.
database=platillos_qa
dbUrl=
dbUser=
dbPassword=
dbSsl=true
dbSslCaFile=certs/us-west-2-rds-ca-bundle.pem
dbSslRejectUnauthorized=true

# AWS/S3. Prefer AWS_PROFILE or the standard AWS credential chain.
awsRegion=us-west-2
AWS_PROFILE=platillos-dev
bucket=platillos-qa

# Legacy explicit credentials; leave blank when using AWS_PROFILE.
awsAccessKey=
awsSecretKey=

# External APIs. Features that use an unset key will be unavailable locally.
recaptchaSiteKey=
recaptchaKey=
googleMapsBrowserKey=
googleMapsKey=
OPENAI_API_KEY=
perplexityKey=
aiModel=gpt-5.4-mini
aiConfidenceThreshold=0.8
